<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Documents are photographed in the in-app scanner. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Office attendance: check-in and check-out tags are read in the app (NFC reader mode). -->
    <uses-permission android:name="android.permission.NFC" />
    <!-- Android 13+: notifications about new messages from the office. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Driver wake-up alarm at the end of the tachograph rest (docs/16): exact alarm clock, the driver allows it. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- The wake-up alarm shows over the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Alarms are lost at a restart: they are set again from the stored rest. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Wake-up calls (docs/25 U5): a sleeping phone must get the push at once, so the driver may exempt the app. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />

    <!-- Remote screen session (docs/29 §4): the stream runs in a foreground service the driver sees and can stop. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!--
      Device management (docs/29 §4.2): granted over adb on managed phones only, so the app can switch its own remote
      help service on. No store install ever holds it.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Device management (docs/29 §3.1): the device owner reads the serial number for the office's device list. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />
    <!-- READ_PHONE_STATE (serial number of a managed device) must not make telephony a requirement: tablets have none. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <!-- Truck navigation apps addressed directly for guidance (NavigationLinks.TRUCK_NAVIGATION_PACKAGES). -->
        <package android:name="com.tomtom.gplay.navapp.gofleet" />
        <package android:name="com.tomtom.gplay.navapp" />
    </queries>

    <application
        android:name=".app.DynamicOneApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DynamicOne.Splash"
        tools:targetApi="36">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Wake-up alarm over the lock screen (opened only by the alarm's full-screen notification). -->
        <activity
            android:name=".app.RestAlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.DynamicOne" />

        <!-- The alarm went off, or snooze / stop on its notification. -->
        <receiver
            android:name=".core.alarm.RestAlarmReceiver"
            android:exported="false" />

        <!-- "Not now" on a road snapshot request notification (docs/24). -->
        <receiver
            android:name=".core.push.SnapshotDismissReceiver"
            android:exported="false" />

        <!-- The planner's wake-up call over the lock screen (docs/25); opened only by the call's full-screen notification. -->
        <activity
            android:name=".app.WakeUpCallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.DynamicOne" />

        <!-- "I'm awake" on the wake-up call notification. -->
        <receiver
            android:name=".core.push.WakeUpCallReceiver"
            android:exported="false" />

        <!--
          Device management (docs/29): device admin and device owner. The name is part of the adb command
          `dpm set-device-owner com.dynamictransport.dynamicone/.core.mdm.DeviceOwnerReceiver`.
        -->
        <receiver
            android:name=".core.mdm.DeviceOwnerReceiver"
            android:description="@string/mdm_admin_description"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- "Stop" on the office's ring notification (docs/29 §3.4). -->
        <receiver
            android:name=".core.mdm.DeviceAlertReceiver"
            android:exported="false" />

        <!-- The office asks to see the screen (docs/29 §4); opened only by the request's full-screen notification. -->
        <activity
            android:name=".core.remote.RemoteSessionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.DynamicOne" />

        <!-- "Decline" on the remote session request notification. -->
        <receiver
            android:name=".core.remote.RemoteSessionReceiver"
            android:exported="false" />

        <!-- The screen stream of an accepted remote session, with its permanent notification (docs/29 §4). -->
        <service
            android:name=".core.remote.ScreenStreamService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Touch and keys for the office during an accepted remote session (docs/29 §4.2); off until switched on. -->
        <service
            android:name=".core.remote.RemoteControlService"
            android:exported="true"
            android:label="@string/remote_control_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- TAR warnings before a terminal window ends (docs/26 §6): the device alarm and its re-arming after a restart. -->
        <receiver
            android:name=".core.tar.TarWarningReceiver"
            android:exported="false" />
        <receiver
            android:name=".core.tar.TarWarningRescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Sets the alarm again after a restart, an app update and clock or permission changes (system broadcasts). -->
        <receiver
            android:name=".core.alarm.RestAlarmRescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Persists the per-app language on API < 33 (AppCompat). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Push signals (docs/13_PUSH_NOTIFICATIONS.md). -->
        <service
            android:name=".core.push.DriverMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          FCM's automatic registration starts only after a driver signs in to the real backend (core/push). A managed
          phone asks for its token itself at check-in (docs/29 §3.6).
        -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <!-- Notifications the system shows from a push while the app is in the background. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="messages" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <!-- WorkManager is initialised on demand with the Hilt worker factory. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
