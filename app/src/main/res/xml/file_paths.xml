<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Document photos (files/document_media) are never shared with other apps. -->
    <!-- Server documents downloaded for viewing; temporary cache, shared read-only with the viewer app. -->
    <cache-path
        name="document_view"
        path="document_view/" />
    <!-- Defect photos of the daily vehicle check: one file at a time is handed to the camera app to write. -->
    <files-path
        name="check_photos"
        path="vehicle_check_media/" />
</paths>
