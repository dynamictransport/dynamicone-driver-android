<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DynamicOne" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- The brand mark (branding/dynamicone-mark.png) on a transparent background, like on the sign-in screen. -->
    <style name="Theme.DynamicOne.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.DynamicOne</item>
    </style>

</resources>
