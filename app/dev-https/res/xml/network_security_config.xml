<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug build only: added by app/build.gradle.kts when tools/Export-DevHttpsCertificate.ps1 has exported
    this PC's ASP.NET Core development certificate. It replaces src/main/res/xml/network_security_config.xml
    in the debug APK; release builds keep the main file.

    tools:ignore: lint reads both source-set copies of this resource and reports a second <debug-overrides>,
    but resource merging puts only this file into the debug APK.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="NetworkSecurityConfig">
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
        debug-overrides are ignored unless the app is debuggable. The development certificate is not a CA,
        so physical devices cannot install it as one; it is trusted here directly instead.
        There is no trust-all TrustManager and hostname verification is never disabled.
    -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
            <certificates src="@raw/dev_https_certificate" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
